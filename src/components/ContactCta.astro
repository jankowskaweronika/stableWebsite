---
import { getSettings } from '../lib/content';

interface Props {
  title?: string;
  text?: string;
  topic?: string;
}

const site = await getSettings();
const {
  title = 'Porozmawiajmy o koniach',
  text = 'Zadzwoń lub napisz — chętnie odpowiemy na pytania, dobierzemy zajęcia i umówimy termin.',
  topic,
} = Astro.props;
const contactHref = topic ? `/kontakt/?temat=${encodeURIComponent(topic)}#formularz` : '/kontakt/#formularz';
---

<section class="relative overflow-hidden border-y border-gold-500/20 bg-forest-950">
  <svg
    viewBox="0 0 200 200"
    class="pointer-events-none absolute -right-20 -bottom-24 size-[28rem] text-gold-500/10"
    fill="none"
    stroke="currentColor"
    stroke-width="10"
    aria-hidden="true"
  >
    <path d="M40 30v70a60 60 0 0 0 120 0V30" stroke-linecap="round"></path>
  </svg>
  <div class="container-page relative flex flex-col gap-10 py-20 lg:flex-row lg:items-end lg:justify-between">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Kontakt</p>
      <h2 class="display mt-4 text-4xl sm:text-5xl">{title}</h2>
      <p class="mt-5 text-lg text-mist">{text}</p>
    </div>
    <div class="reveal flex flex-col gap-3 sm:flex-row">
      <a href={contactHref} class="btn-gold">Napisz do nas</a>
      <a href={`tel:${site.phone.number}`} class="btn-ghost whitespace-nowrap">Zadzwoń {site.phone.display}</a>
    </div>
  </div>
</section>
