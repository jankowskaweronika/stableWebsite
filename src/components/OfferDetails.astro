---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import PriceCategory from './PriceCategory.astro';
import PhotoGrid from './PhotoGrid.astro';
import { getOffer, getPriceCategories } from '../lib/content';
import { resolveImage } from '../lib/images';

interface Props {
  offerId: string;
  priceCategoryId: string;
  includedTitle: string;
  infrastructureTitle?: string;
  extraServicesTitle?: string;
  galleryTitle: string;
  topic: string;
  ctaLabel: string;
}

const { offerId, priceCategoryId, includedTitle, infrastructureTitle, extraServicesTitle, galleryTitle, topic, ctaLabel } =
  Astro.props;
const offer = await getOffer(offerId);
const { Content } = await render(offer);
const priceCategory = (await getPriceCategories()).find((category) => category.id === priceCategoryId);

const lists = [
  { title: includedTitle, items: offer.data.included },
  { title: infrastructureTitle, items: offer.data.infrastructure },
  { title: extraServicesTitle, items: offer.data.extraServices },
].filter((list): list is { title: string; items: string[] } => Boolean(list.title) && list.items.length > 0);
---

<section class="container-page grid gap-14 py-20 lg:grid-cols-12 lg:gap-20">
  <div class="reveal prose-stable lg:col-span-7">
    <Content />
  </div>
  <div class="reveal lg:col-span-5">
    <div class="aspect-[4/5] overflow-hidden rounded-lg">
      <Picture
        src={resolveImage(offer.data.image)}
        alt={offer.data.imageAlt}
        formats={['avif', 'webp']}
        widths={[400, 700, 1000]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="h-full w-full object-cover"
      />
    </div>
  </div>
</section>

{
  lists.length > 0 && (
    <section class="bg-forest-950 py-20">
      <div class="container-page grid gap-12 md:grid-cols-2 lg:grid-cols-3">
        {lists.map((list) => (
        <div class="reveal">
          <p class="eyebrow">{list.title}</p>
          <ul class="mt-6 divide-y divide-forest-800 border-y border-forest-800">
            {list.items.map((item) => (
              <li class="flex items-start gap-4 py-4 text-lg text-cream">
                <span class="mt-2.5 size-1.5 shrink-0 rotate-45 bg-gold-400" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </div>
        ))}
      </div>
    </section>
  )
}

{
  offer.data.gallery.length > 0 && (
    <section aria-label={galleryTitle} class="container-page py-20">
      <p class="eyebrow reveal mb-8">{galleryTitle}</p>
      <PhotoGrid photos={offer.data.gallery} />
    </section>
  )
}

{
  priceCategory && (
    <div class="container-page pb-20">
      <PriceCategory
        id={priceCategory.id}
        title={priceCategory.data.title}
        intro={priceCategory.data.intro}
        items={priceCategory.data.items}
        extras={priceCategory.data.extras}
        index={1}
      />
      <div class="reveal flex flex-col gap-3 sm:flex-row">
        <a href={`/kontakt/?temat=${encodeURIComponent(topic)}#formularz`} class="btn-gold">
          {ctaLabel}
        </a>
        <a href="/cennik/" class="btn-ghost">
          Pełny cennik
        </a>
      </div>
    </div>
  )
}
