---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Dziękujemy za wiadomość" description="Wiadomość została wysłana." noindex>
  <section class="container-page grid min-h-[70vh] place-content-center pt-32 pb-20 text-center">
    <p class="eyebrow">Wiadomość wysłana</p>
    <h1 class="display mt-5 text-5xl sm:text-6xl">Dziękujemy!</h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-mist">Otrzymaliśmy Twoją wiadomość i odezwiemy się najszybciej, jak to możliwe.</p>
    <p class="mt-10"><a href="/" class="btn-gold">Wróć na stronę główną</a></p>
  </section>
</BaseLayout>
