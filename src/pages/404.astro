---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nie znaleziono strony" description="Strona, której szukasz, nie istnieje." noindex>
  <section class="container-page grid min-h-[80vh] place-content-center pt-32 pb-20 text-center">
    <svg viewBox="0 0 200 200" class="mx-auto size-28 text-gold-400/70" fill="none" stroke="currentColor" stroke-width="8" aria-hidden="true">
      <path d="M40 30v70a60 60 0 0 0 120 0V30" stroke-linecap="round"></path>
    </svg>
    <p class="eyebrow mt-8">Błąd 404</p>
    <h1 class="display mt-5 text-5xl sm:text-6xl">Ta ścieżka prowadzi <em class="text-gold-200">w pole</em></h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-mist">Strona, której szukasz, nie istnieje lub została przeniesiona.</p>
    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-gold">Strona główna</a>
      <a href="/kontakt/" class="btn-ghost">Kontakt</a>
    </div>
  </section>
</BaseLayout>
