---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import PostalAddress from '../../components/PostalAddress.astro';
import { getSettings } from '../../lib/content';

const site = await getSettings();
---

<BaseLayout
  title="Kontakt"
  description={`Kontakt ze Stajnią Złota Podkowa — telefon, adres (${site.address.street}, ${site.address.locality}), mapa dojazdu i formularz kontaktowy.`}
>
  <PageHero
    eyebrow="Kontakt"
    title="Zapraszamy <em class='text-gold-200'>do stajni</em>"
    lead="Zadzwoń, napisz lub odwiedź nas w Niedrzwicy Kościelnej. Najszybciej złapiesz nas telefonicznie."
  />

  <section class="container-page grid gap-16 pb-20 lg:grid-cols-12">
    <div class="space-y-10 lg:col-span-5">
      <div class="reveal">
        <h2 class="eyebrow">Telefon</h2>
        <p class="mt-4">
          <a href={`tel:${site.phone.number}`} class="font-display text-4xl whitespace-nowrap text-cream transition hover:text-gold-200">
            {site.phone.display}
          </a>
        </p>
      </div>

      <div class="reveal">
        <h2 class="eyebrow">E-mail</h2>
        <p class="mt-4 text-lg">
          <a href={`mailto:${site.email}`} class="link-gold">{site.email}</a>
        </p>
      </div>

      <div class="reveal">
        <h2 class="eyebrow">Adres</h2>
        <address class="mt-4 text-lg leading-relaxed text-cream not-italic">
          <span class="block">{site.name}</span>
          <PostalAddress address={site.address} />
        </address>
      </div>

      <div class="reveal">
        <h2 class="eyebrow">Znajdziesz nas też tu</h2>
        <SocialLinks socials={site.socials} class="mt-4" />
      </div>
    </div>

    <div class="reveal lg:col-span-7">
      <div class="rounded-lg border border-forest-700/80 bg-forest-900/70 p-6 sm:p-10">
        <h2 class="display text-4xl">Napisz do nas</h2>
        <p class="mt-3 mb-8 text-mist">Odpowiemy najszybciej, jak to możliwe.</p>
        <ContactForm />
      </div>
    </div>
  </section>

  <section aria-labelledby="dojazd" class="container-page pb-24">
    <h2 id="dojazd" class="display reveal mb-8 text-4xl">Dojazd</h2>
    <MapEmbed />
  </section>
</BaseLayout>
