---
import Wordmark from './Wordmark.astro';
import { contactLink, isCurrentPath, mainNavigation } from '../lib/navigation';
import { getSettings } from '../lib/content';

const site = await getSettings();
const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-40" data-site-header>
  <div
    class="absolute inset-0 -z-10 border-b border-cream/10 bg-night/75 backdrop-blur-md transition-colors duration-500 data-[scrolled]:border-gold-500/20 data-[scrolled]:bg-night/95"
    data-header-backdrop
  >
  </div>
  <a
    href="#tresc"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-gold-400 focus:px-4 focus:py-2 focus:text-night"
  >
    Przejdź do treści
  </a>
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href="/" class="group flex items-center whitespace-nowrap" aria-label={`${site.name} — strona główna`}>
      <Wordmark name={site.name} />
    </a>

    <nav aria-label="Główna nawigacja" class="hidden lg:block">
      <ul class="flex items-center gap-5 text-[0.95rem] tracking-wide whitespace-nowrap xl:gap-9">
        {
          mainNavigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrentPath(currentPath, item.href) ? 'page' : undefined}
                class="relative py-2 font-medium text-cream transition hover:text-gold-200 aria-[current=page]:text-gold-200 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-gold-400 after:transition after:duration-500 hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={contactLink.href} class="btn-ghost min-h-10 px-5 py-2 text-xs">
            {contactLink.label}
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      <a
        href={`tel:${site.phone.number}`}
        class="grid size-11 place-items-center rounded-full border border-gold-400/40 text-gold-200"
        aria-label={`Zadzwoń: ${site.phone.display}`}
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
        </svg>
      </a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full border border-gold-400/40 text-gold-200"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>Otwórz menu</span>
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h10" data-icon-open></path>
          <path d="M6 6l12 12M18 6 6 18" class="hidden" data-icon-close></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Menu mobilne"
    class="fixed inset-x-0 top-20 bottom-0 hidden overflow-y-auto bg-night/97 backdrop-blur-lg lg:hidden data-[open]:block"
    data-mobile-menu
  >
    <ul class="container-page flex flex-col gap-1 py-10">
      {
        [...mainNavigation, contactLink].map((item, index) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrentPath(currentPath, item.href) ? 'page' : undefined}
              class="flex items-baseline gap-5 border-b border-forest-800 py-4 font-display text-3xl text-cream aria-[current=page]:text-gold-200"
            >
              <span class="font-sans text-xs tracking-[0.3em] text-gold-400">{String(index + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  import { initHeader } from '../scripts/header';
  initHeader();
</script>
